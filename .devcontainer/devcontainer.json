{
  "name": "FarmData2 Development Environment",
  // "build": {
  //   "dockerfile": "Dockerfile"
  // },
  "image": "farmdata2/fd2dev:fd2.14",
  "containerEnv": {
    "TZ": "America/New_York"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/fd2dev/FarmData2,type=bind",
  "workspaceFolder": "/home/fd2dev/FarmData2",
  "remoteUser": "fd2dev",
  // "features": {
  //   "ghcr.io/devcontainers/features/docker-in-docker:2": {},
  //   "ghcr.io/devcontainers/features/github-cli:1": {},
  //   "ghcr.io/devcontainers/features/desktop-lite:1": {
  //     "password": "noPassword",
  //     "webPort": "6901",
  //     "vncPort": "5901"
  //   }
  // },
  //"onCreateCommand": ".devcontainer/onCreate.bash",
  "postCreateCommand": ".devcontainer/postCreate.bash",
  "postStartCommand": ".devcontainer/postStart.bash",
  "postAttachCommand": ".devcontainer/postAttach.bash",
  "portsAttributes": {
    "443": {
      "label": "farmOS",
      "protocol": "https",
      "onAutoForward": "silent"
    },
    "6901": {
      "label": "noVNC",
      "protocol": "http",
      "onAutoForward": "silent"
    },
    "8082": {
      "label": "docs",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": true,
        "remote.autoForwardPortsSource": "output"
      },
      "extensions": [
        "Vue.volar",
        "streetsidesoftware.code-spell-checker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bierner.markdown-preview-github-styles",
        "timonwong.shellcheck",
        "chrischinchilla.vale-vscode@0.20.0"
      ]
    }
  }
}
