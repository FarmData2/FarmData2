{
  "remoteUser": "fd2dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "mounts": [
    "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock"
  ],
  "forwardPorts": [80, 5901, 6901],
  "portsAttributes": {
    "80": {
      "label": "farmOS Instance"
    },
    "5901": {
      "label": "FarmData2 VNC"
    },
    "6901": {
      "label": "FarmData2 NoVNC"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "tasks": {
          "version": "2.0.0",
          "tasks": [
            {
              "label": "Set docker.sock group",
              "type": "shell",
              "command": "echo 'fd2dev' | sudo -S chgrp docker /var/run/docker.sock",
              "presentation": {
                "reveal": "always",
                "panel": "shared"
              }
            },
            {
              "label": "Run bin/fd2-up.bash (1)",
              "type": "shell",
              "command": "bin/fd2-up.bash",
              "presentation": {
                "reveal": "always",
                "panel": "shared"
              }
            },
            {
              "label": "Run bin/fd2-up.bash (2)",
              "type": "shell",
              // fd2-up.linux.bash has to be run twice the first time it
              // is run.  When it has run twice the fd2grp.gid file will
              // exist, so this task will only run the first time the
              // codespace is launched.
              "command": "if [ ! -f .fd2/gid/fd2grp.gid  ]; then bin/fd2-up.bash; fi",
              "presentation": {
                "reveal": "always",
                "panel": "shared"
              }
            },
            {
              "label": "Start FD2 Dev Environment",
              "dependsOrder": "sequence",
              "dependsOn": [
                "Set docker.sock group",
                "Run bin/fd2-up.bash (1)",
                "Run bin/fd2-up.bash (2)"
                //"Run FD2 Dev Environment",
                //"Open FD2 Dev Environment"
              ],
              "runOptions": {
                "runOn": "folderOpen"
              }
            }
          ]
        }
      }
    }
  }
}
