{
  "name": "FarmData2 Development Environment",
  "dockerComposeFile": "compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/FarmData2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "noPassword",
      "webPort": "6901",
      "vncPort": "5901"
    }
  },
  "remoteEnv": {
    "DOCKER_API_VERSION": "1.43"
  },
  "mounts": [
    "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock",
    "type=volume,source=farmos3_db_fd2.1,target=/workspaces/FarmData2/docker/db"
  ],
  "onCreateCommand": ".devcontainer/onCreate.bash",
  "forwardPorts": [80, 443, 6901],
  "portsAttributes": {
    "80": {
      "label": "farmOS(http)",
      "onAutoForward": "silent"
    },
    "443": {
      "label": "farmOS(https)",
      "onAutoForward": "silent"
    },
    "6901": {
      "label": "Cypress",
      "onAutoForward": "silent"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "streetsidesoftware.code-spell-checker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bierner.markdown-preview-github-styles",
        "timonwong.shellcheck",
        "chrischinchilla.vale-vscode"
      ]
    }
  }
}
