{
  "name": "FarmData2 Development Environment",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:0-18-bullseye",
  "workspaceFolder": "/workspaces/FarmData2",
  "containerUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "noPassword",
      "webPort": "6901",
      "vncPort": "5901"
    }
  },
  // "remoteEnv": {
  //   "DOCKER_API_VERSION": "1.43"
  // },
  // "mounts": [
  //   "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock",
  //   "type=volume,source=farmos3_db_fd2.1,target=/workspaces/FarmData2/docker/db"
  // ],
  "onCreateCommand": ".devcontainer/onCreate.bash",
  "postCreateCommand": ".devcontainer/postCreate.bash",
  "postStartCommand": ".devcontainer/postStart.bash",
  //"postAttachCommand": ".devcontainer/postAttach.bash",
  // "forwardPorts": [443, 6901],
  "portsAttributes": {
    "6901": {
      "label": "Cypress",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "otherPortsAttributes": {
    "label": "farmOS",
    "protocol": "https",
    "onAutoForward": "silent"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": true,
        "remote.autoForwardPortsSource": "output"
      },
      "extensions": [
        "Vue.volar",
        "streetsidesoftware.code-spell-checker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bierner.markdown-preview-github-styles",
        "timonwong.shellcheck",
        "chrischinchilla.vale-vscode"
      ]
    }
  }
}
