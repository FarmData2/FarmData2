{
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/shinepukur/devcontainer-features/vale:1": {}
  },
  "mounts": [
    "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock"
  ],
  "forwardPorts": [80, 5901, 6901],
  "portsAttributes": {
    "80": {
      "label": "farmOS Instance"
    },
    "5901": {
      "label": "FarmData2 VNC"
    },
    "6901": {
      "label": "FarmData2 NoVNC"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        // Hide a bunch of the VSCode UI elements.
        "workbench.startupEditor": "none",
        "workbench.activityBar.location": "hidden",
        "workbench.statusBar.visible": false,
        "window.commandCenter": false,
        "window.menuBarVisibility": "hidden",
        "workbench.editor.restoreViewState": false,
        "workbench.editor.editorActionsLocation": "hidden",
        "workbench.editor.showTabs": "none",
        "workbench.layoutControl.enabled": false,
        "workbench.panel.opensMaximized": "always",
        "tasks": {
          "version": "2.0.0",
          "tasks": [
            {
              "label": "Open FarmData Dev Environment",
              "type": "shell",
              "dependsOrder": "sequence",
              "dependsOn": [
                "Hide UI Elements",
                "Run fd2-up.bash Script",
                "Hide Panel",
                "Open noVNC in Browser"
              ],
              "runOptions": {
                "runOn": "folderOpen"
              }
            },
            {
              "label": "Hide UI Elements",
              "command": "${input:hideUIElements}"
            },
            {
              "label": "Run fd2-up.bash Script",
              "type": "shell",
              "command": "bin/fd2-up.bash",
              "presentation": {
                "reveal": "always",
                "panel": "shared"
              }
            },
            {
              "label": "Open noVNC in Browser",
              "command": "${input:openSimpleBrowser}"
            },
            {
              "label": "Hide Panel",
              "command": "${input:hidePanel}"
            }
          ],
          "inputs": [
            {
              "id": "openSimpleBrowser",
              "type": "command",
              "command": "simpleBrowser.show",
              "args": [
                "https://${env:CODESPACE_NAME}-6901.app.github.dev?autoconnect=true&resize=remote"
              ]
            },
            {
              // Hide some additional UI elements for which there is no setting.
              "id": "hideUIElements",
              "type": "command",
              "command": "runCommands",
              "args": {
                "commands": [
                  "workbench.action.closeSidebar",
                  "workbench.action.closeAllEditors"
                  //"workbench.action.toggleMaximizedPanel"
                ]
              }
            },
            {
              "id": "hidePanel",
              "type": "command",
              "command": "workbench.action.closePanel"
            }
          ]
        }
      },
      "extensions": [
        // Install extensions so that we hide the prompt to install.
        "Vue.volar",
        "streetsidesoftware.code-spell-checker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bierner.markdown-preview-github-styles",
        "timonwong.shellcheck",
        "mkhl.shfmt",
        "chrischinchilla.vale-vscode"
      ]
    }
  }
}
